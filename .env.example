TELEGRAM_BOT_TOKEN=123456:your-bot-token-here

WHITELIST=derise,friend1,friend2

ADMIN_USERNAME=derise

ZOTIFY_CREDENTIALS_PATH=/data/credentials.json

# Optional: enable Yandex Music support.
# Obtain OAuth token at https://ym.marshal.dev/token/#implicit-oauth
# If not set, Yandex.Music links will be answered with "not configured".
YANDEX_MUSIC_TOKEN=

# Optional: raise 50 MB upload limit to 2 GB by routing the bot through a
# local Bot API server (see README > "Raising the 50 MB limit").
# When running via docker-compose these are set automatically — you only
# need to fill in TELEGRAM_API_ID and TELEGRAM_API_HASH.
# TELEGRAM_BOT_API_ROOT=http://tg-bot-api:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: enable inline search across Spotify.
# Register a free app at https://developer.spotify.com/dashboard, copy Client
# ID + Secret. Uses Client Credentials flow (no user OAuth). Yandex inline
# search auto-enables when YANDEX_MUSIC_TOKEN is set.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: enable inline delivery INTO the target chat (any chat where the
# user did the inline query — group, channel, DM). Create a private channel,
# add the bot as admin (posting rights), and put the numeric channel id here
# (starts with -100...). See README > "Inline: delivery into the target chat".
# When unset, inline files are delivered to the user's DM with the bot.
STORAGE_CHAT_ID=
