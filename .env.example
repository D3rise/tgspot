TELEGRAM_BOT_TOKEN=123456:your-bot-token-here
WHITELIST=derise,friend1,friend2
ADMIN_USERNAME=derise

# Native credentials JSON from librespot 0.8, as a single compact JSON line. No credentials file/mount needed.
# Dummy example; replace with your own credentials. Never commit the real value.
SPOTIFY_CREDENTIALS_JSON={"username":"your-spotify-user","auth_type":1,"auth_data":"base64-auth-data"}

# Optional Yandex Music OAuth token; enables downloads and search.
# https://ym.marshal.dev/token/#implicit-oauth
YANDEX_MUSIC_TOKEN=

# Optional Spotify Web API client credentials; enables text search.
# Direct Spotify links and album metadata use librespot without these variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional private channel ID for inline delivery into the target chat.
# Without it, inline downloads are sent to the user's DM with the bot.
STORAGE_CHAT_ID=

# Public Bot API by default. Compose overrides this with the local Bot API server.
# TELEGRAM_BOT_API_ROOT=http://tg-bot-api:8081
# Required by the optional local Bot API server in docker-compose.yml:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# RUST_LOG=tgspot=info,librespot=warn
